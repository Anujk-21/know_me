---
import SectionHead from './SectionHead.astro';
import profile from '../data/profile.json';
import skills from '../data/skills.json';
import edu from '../data/education.json';
---
<section id="about" class="section">
  <div class="wrap">
    <SectionHead n="01" title="About" sub="The short version. The long one needs coffee." />

    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div class="space-y-5 text-[17px] leading-relaxed" data-reveal>
        {profile.about.map((p) => <p>{p}</p>)}
      </div>
      <div class="grid grid-cols-2 gap-4" data-reveal>
        {profile.highlights.map((h) => (
          <div class="card card-hover p-5">
            <p class="font-mono text-2xl text-teal">{h.value}</p>
            <p class="mt-1 text-sm text-muted">{h.label}</p>
          </div>
        ))}
      </div>
    </div>

    <p class="label mt-20" data-reveal>toolkit</p>
    <div class="mt-5 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal>
      {Object.entries(skills).map(([group, items]) => (
        <div>
          <p class="mb-2 text-sm text-ink">{group}</p>
          <div class="flex flex-wrap gap-2">{items.map((s) => <span class="chip">{s}</span>)}</div>
        </div>
      ))}
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2" data-reveal>
      <div class="card p-6">
        <p class="label">education</p>
        <p class="mt-3 text-lg text-ink">{edu.degree}</p>
        <p class="text-muted">{edu.school}</p>
        <p class="mt-2 font-mono text-xs text-dim">{edu.years} · {edu.cgpa}</p>
        <ul class="mt-4 space-y-1 text-sm">
          {edu.achievements.map((a) => <li><span class="text-teal">★</span> {a}</li>)}
        </ul>
      </div>
      <div class="card p-6">
        <p class="label">publication · IEEE</p>
        <p class="mt-3 text-lg text-ink">{edu.publication.title}</p>
        <p class="mt-1 text-sm text-muted">{edu.publication.venue}</p>
        <a href={edu.publication.url} target="_blank" rel="noopener" class="mt-4 inline-block font-mono text-sm text-violet">read paper →</a>
      </div>
    </div>
  </div>
</section>