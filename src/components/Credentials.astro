---
import SectionHead from './SectionHead.astro';
import profile from '../data/profile.json';
import { getBadges } from '../lib/credly';
const badges = await getBadges();
---
<section id="credentials" class="section">
  <div class="wrap">
    <SectionHead n="04" title="Credentials" sub="Verified on Credly, so you don't have to take my word for it." />
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5" data-reveal>
      {badges.map((b) => (
        <a href={b.url} target="_blank" rel="noopener" class="card card-hover group flex flex-col items-center p-5 text-center">
          <img src={b.image} alt={b.name} width="96" height="96" loading="lazy" class="h-24 w-24 object-contain transition group-hover:scale-105" />
          <p class="mt-4 text-sm text-ink">{b.name}</p>
          <p class="mt-1 font-mono text-[11px] text-dim">{b.issuer}</p>
        </a>
      ))}
    </div>
    <a href={profile.links.credly} target="_blank" rel="noopener" class="btn-ghost mt-10">all badges on credly →</a>
  </div>
</section>